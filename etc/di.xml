<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Open/closed seam: register the Okta preset into customer-sso's registry. -->
    <type name="DmLab\CustomerSso\Model\PresetRegistry">
        <arguments>
            <argument name="presets" xsi:type="array">
                <item name="okta" xsi:type="object">DmLab\CustomerSsoOkta\Model\OktaPreset</item>
            </argument>
        </arguments>
    </type>
</config>

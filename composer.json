{
    "name": "dmlab/module-customer-sso-okta",
    "description": "Okta provider plugin for Magento 2 storefront SSO — supplies the Okta OIDC preset (discovery, groups claim, branding) for the provider-agnostic customer-sso capability. Installs customer-sso (and sso-core) automatically.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.2.0",
    "authors": [
        {
            "name": "DMLab",
            "homepage": "https://dmlab.work"
        }
    ],
    "homepage": "https://github.com/dmlab-work/module-customer-sso-okta",
    "support": {
        "issues": "https://github.com/dmlab-work/module-customer-sso-okta/issues",
        "source": "https://github.com/dmlab-work/module-customer-sso-okta"
    },
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=103.0",
        "magento/module-store": ">=101.1",
        "magento/module-config": ">=101.2",
        "dmlab/module-customer-sso": "^0.2.0",
        "dmlab/module-sso-core": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\CustomerSsoOkta\\": ""
        }
    }
}
